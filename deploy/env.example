# /etc/archci-web/env -- the front end's settings (mode 600, root:archci-web).
# the master, as the web key sees it (ssh destination and the key file)
ARCHCI_MASTER=archci@master
ARCHCI_SSH_KEY=/etc/archci-web/web_key
# the operator's password for retry, requeue and enqueue; unset: those are off
#ARCHCI_WEB_PASSWORD=
# rails: a long random string (bin/rails secret)
SECRET_KEY_BASE=
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1
# puma: bind and thread count (a live-log viewer holds a thread while open)
PORT=3000
RAILS_MAX_THREADS=16
# TLS is terminated by caddy in front; set this to 0 to run on plain http
# during bring-up (before a domain and certificate exist).
#ARCHCI_WEB_FORCE_SSL=0
# lock the site to one hostname (optional; caddy is the guard otherwise)
#ARCHCI_WEB_HOST=archci.example.org
# the version the footer shows (a git checkout says it by itself)
#ARCHCI_WEB_VERSION=
