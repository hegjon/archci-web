<% content_for :title, "#{@job.pkgbase} #{@job.version} #{@job.arch}" %>
<% content_for :refresh, @job.running? ? 5000 : 0 %>
<section class="job">
  <h2><%= @job.pkgbase %> <%= @job.version %> <span class="muted"><%= @job.arch %>, from <%= @job.origin %></span> <%= state_badge(@job.state) %></h2>
  <p class="story"><%= @job.story %></p>
  <dl class="facts">
    <dt>job</dt><dd><%= @job.id %></dd>
    <dt>commit</dt><dd><% if (u = @job.package_dir_url) %><%= link_to @job.commit, u, title: "the package directory at this commit" %><% else %><%= @job.commit %><% end %></dd>
    <% if @job.sources %><dt>sources</dt><dd><%= @job.sources_job ? link_to(@job.sources, job_path(@job.sources_job.tr(",", "/"))) : @job.sources %></dd><% end %>
    <% if @job.network %><dt>network</dt><dd><%= @job.network %></dd><% end %>
    <% if @job.retried_as %><dt>retried as</dt><dd><%= link_to @job.retried_as, job_path(@job.retried_as.tr(",", "/")) %> <span class="muted">a new job; this one is history</span></dd><% end %>
    <% if @job.running? %><dt>phase</dt><dd><%= @job.phase || "-" %> · <%= mem(@job.rss) %> rss, <%= mem(@job.peak) %> peak, <%= mem(@job.build) %> build tree</dd><% end %>
    <% if @job.running? && (bt = build_time(@job)) %><dt>build time</dt><dd><%= bt %></dd><% end %>
    <%# a finished build's time, and its online/build split, the log controller works out from the log's stream (each entry's time, the slice markers, the finish record) %>
    <%# the row is there from the start, a spinner in it until the log controller has the whole stream and fills it (by id: the facts live outside its permanent section) %>
    <% if @job.finished? %><dt>build time</dt><dd id="build-time"><span class="spinner" title="computing from the log"></span></dd><% end %>
    <%# the last heartbeat's numbers, kept in the job file when the build ended %>
    <% if @job.finished? && @job.peak.present? %><dt>peak memory</dt><dd><%= mem(@job.peak) %><% if @job.build.present? %> <span class="muted">·</span> <%= mem(@job.build) %> build tree<% end %></dd><% end %>
    <dt>log</dt><dd class="muted"><% if @job.log_url %><%= link_to @job.exported, @job.log_url %> <span class="muted">on the release</span><% elsif @job.running? %>the journal so far, streamed<% elsif @job.pending? %>none yet<% else %>the journal on the master<%= ", not exported yet" if @job.exported.blank? %><% end %></dd>
  </dl>
  <% if operator_commands? %>
    <div class="actions">
      <% if @job.retryable? %><%= button_to "retry (a new job)", retry_job_path(@job), class: "btn", form: { data: { turbo_confirm: "Retry #{@job.pkgbase} #{@job.arch} as a new job?" } } %><% end %>
      <% if @job.requeueable? %><%= button_to "requeue (keep the attempts)", requeue_job_path(@job), class: "btn", form: { data: { turbo_confirm: "Put #{@job.pkgbase} #{@job.arch} back in pending?" } } %><% end %>
    </div>
  <% end %>
</section>

<%# The PKGBUILD as built, in a panel closed by default: the log controller
    fills it from the log's stream, where the worker's PKGBUILD record
    carries the file (its "pkgbuild"); a log from before the worker logged
    it leaves the note. Permanent, so a running job's refresh keeps it. %>
<details class="pkgbuild" id="pkgbuild-<%= @job.id.gsub(/[^a-zA-Z0-9]/, "-") %>" data-turbo-permanent>
  <summary>PKGBUILD <span class="muted">as built, at <%= @job.commit.to_s[0, 12] %></span></summary>
  <p class="muted" id="pkgbuild-missing"><%= @job.pending? ? "not built yet" : "not logged" %></p>
  <pre class="code" id="pkgbuild" hidden></pre>
</details>

<%# The log window is built by the log controller from the events of the
    job's log stream: an EventSource on the exported file on R2 for a
    finished job (r2-url), else on the sse action, which streams a running
    job's log as it grows. The section is permanent so the page's refresh
    keeps it. %>
<section class="log-section" id="logbox-<%= @job.id.gsub(/[^a-zA-Z0-9]/, "-") %>" data-turbo-permanent
         data-controller="log"
         data-log-url-value="<%= sse_job_path(@job) %>"
         data-log-r2-url-value="<%= @job.log_url %>"
         data-log-after-value=""
         data-log-count-value="0"
         data-log-state-value="<%= @job.state %>">
  <h2>log <span class="badge badge-live" data-log-target="live" hidden title="streamed from the worker's journal as the build writes it">live</span> <span class="muted" data-log-target="status">loading…</span></h2>
  <p class="muted" data-log-target="empty" hidden><%= @job.pending? ? "not started yet" : (@job.running? ? "nothing streamed yet" : "no log") %></p>
  <pre class="log" id="log" data-log-target="pre" hidden></pre>
</section>
