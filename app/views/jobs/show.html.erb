<% content_for :title, "#{@job.pkgbase} #{@job.version} #{@job.arch}" %>
<% content_for :refresh, @job.running? ? 5000 : 0 %>
<section class="job">
  <h2><%= @job.pkgbase %> <%= @job.version %> <span class="muted"><%= @job.arch %>, from <%= @job.origin %></span> <%= state_badge(@job.state) %></h2>
  <p class="story"><%= @job.story %></p>
  <dl class="facts">
    <dt>job</dt><dd><%= @job.id %></dd>
    <dt>commit</dt><dd><%= @job.commit %></dd>
    <% if @job.sources %><dt>sources</dt><dd><%= @job.sources_job ? link_to(@job.sources, job_path(@job.sources_job.tr(",", "/"))) : @job.sources %></dd><% end %>
    <% if @job.network %><dt>network</dt><dd><%= @job.network %></dd><% end %>
    <% if @job.running? %><dt>phase</dt><dd><%= @job.phase || "-" %> · <%= mem(@job.rss) %> rss, <%= mem(@job.peak) %> peak, <%= mem(@job.build) %> build tree</dd><% end %>
    <% if (bt = build_time(@job)) %><dt>build time</dt><dd><%= bt %><% if (sp = build_split(@job)) %> <span class="muted">·</span> <span class="net-online">online <%= sp[:online] %></span> <span class="muted">·</span> <span class="net-<%= sp[:slice] %>"><%= sp[:slice] %> <%= sp[:build] %></span><% end %></dd><% end %>
    <dt>log</dt><dd class="muted"><%= @job.log || "none yet" %><%= " (the journal so far)" if @job.running? %></dd>
  </dl>
  <% if operator_commands? %>
    <div class="actions">
      <% if @job.retryable? %><%= button_to "retry (a fresh first attempt)", retry_job_path(@job), class: "btn", form: { data: { turbo_confirm: "Retry #{@job.pkgbase} #{@job.arch} from scratch?" } } %><% end %>
      <% if @job.requeueable? %><%= button_to "requeue (keep the attempts)", requeue_job_path(@job), class: "btn", form: { data: { turbo_confirm: "Put #{@job.pkgbase} #{@job.arch} back in pending?" } } %><% end %>
    </div>
  <% end %>
</section>

<%# The log window is built by the log controller from the journal entries
    the log action returns (each line with its time and cursor); a running
    job's is then appended every few seconds with only the entries after the
    cursor last seen. The section is permanent so the page's refresh keeps it. %>
<section class="log-section" id="logbox-<%= @job.id.gsub(/[^a-zA-Z0-9]/, "-") %>" data-turbo-permanent
         data-controller="log"
         data-log-url-value="<%= log_job_path(@job) %>"
         data-log-after-value=""
         data-log-count-value="0"
         data-log-state-value="<%= @job.state %>"
         data-log-interval-value="<%= @job.running? ? 5000 : 0 %>">
  <h2>log <span class="muted" data-log-target="status">loading…</span></h2>
  <p class="muted" data-log-target="empty" hidden><%= @job.pending? ? "not started yet" : (@job.running? ? "nothing streamed yet" : "no log") %></p>
  <pre class="log" id="log" data-log-target="pre" hidden></pre>
</section>
